# Maestro CLI Configuration
# Copy this file to .env and fill in your values

# LLM Configuration
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Audio Configuration
AUDIO_SAMPLE_RATE=48000
AUDIO_BIT_DEPTH=24
AUDIO_BUFFER_SIZE=256

# MIDI Configuration
MIDI_TICKS_PER_BEAT=480
MIDI_VELOCITY_MIN=64
MIDI_VELOCITY_MAX=127
MIDI_HUMANIZE=true
MIDI_HUMANIZE_AMOUNT=0.1

# Carla Configuration
CARLA_HOST=127.0.0.1
CARLA_OSC_PORT=9001
CARLA_SERVER_PORT=9002
CARLA_TIMEOUT=5
CARLA_RACK_PATH=~/.carla/racks/default.rck
CARLA_START_CMD=carla

# Project Directories
SONGS_DIR=songs/projects
CONFIG_DIR=configs
PROMPTS_DIR=prompts

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs

# Debug
DEBUG=false
