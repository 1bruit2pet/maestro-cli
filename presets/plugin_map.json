  "fallback": {
    "enabled": true,
    "synth": "fluidsynth",
    "soundfont": "/usr/share/sounds/sf2/GeneralUser_GS.sf2",
    "command": "fluidsynth -ni {soundfont} {midi_file} -F {output_wav} -r {sample_rate}",
    "quality": "good"
  },
  "search_paths": [
    "/usr/lib/vst3",
    "/usr/lib/lv2",
    "/usr/lib/ladspa",
    "~/vst3",
    "~/plugins"
  ]
}
